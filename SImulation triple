# 1. Physiology & Spatial Parameters
# ==========================================
class PhysiologyGenerator:
    def __init__(self):
        # 14-Comp PBPK Volumes (L/kg)
        self.tissue_vols = {
            'Adipose': 0.214, 'Bone': 0.1, 'Brain': 0.02, 'Gut': 0.024,
            'Heart': 0.005, 'Kidney': 0.004, 'Liver': 0.026, 'Lung': 0.014,
            'Muscle': 0.4, 'Pancreas': 0.001, 'Skin': 0.037, 'Spleen': 0.002,
            'Thymus': 0.0004, 'Blood': 0.07
        }
        # Blood flows (% CO)
        self.tissue_flows = {
            'Adipose': 0.05, 'Bone': 0.05, 'Brain': 0.12, 'Gut': 0.15,
            'Heart': 0.04, 'Kidney': 0.19, 'Liver': 0.06, 'Lung': 1.0, 
            'Muscle': 0.17, 'Pancreas': 0.01, 'Skin': 0.05, 'Spleen': 0.03,
            'Thymus': 0.001
        }
    def generate_patient(self, pid, cancer_type):
        sex = np.random.choice(['M', 'F'])
        weight = np.random.normal(75, 15)
        bsa = 0.007184 * (weight**0.425) * (170**0.725)
        co = (13.0 * (bsa**0.75)) * 60 / 1000 # L/hr
        
        vols = {k: v * weight for k, v in self.tissue_vols.items()}
        flows = {k: v * co for k, v in self.tissue_flows.items()}
        
        # Tumor Props (Spatial)
        # Stroma Density (0-1): Determines diffusion barrier
        stroma_density = np.random.beta(2, 2) 
        if cancer_type == 'Pancreatic': stroma_density = np.random.beta(5, 1) # Very dense
        
        return {
            'id': pid, 'weight': weight, 'vols': vols, 'flows': flows,
            'cancer_type': cancer_type, 'stroma': stroma_density,
            'clones': self.init_clones()
        }
    
    def init_clones(self):
        # Clone A: Sensitive (95-99%)
        # Clone B: Pre-existing Resistant (1-5%)
        # Clone C: Empty (Evolves later)
        frac_b = np.random.uniform(0.01, 0.05)
        return {'A': 1.0 - frac_b, 'B': frac_b, 'C': 0.0}
# ==========================================
# 2. Hyper-Realistic Spatial Model
# ==========================================
class SpatialModel:
    def __init__(self, patient):
        self.p = patient
        # State Vector Map (Size 60)
        # 0-14: Drug 1 (PBPK + Tumor Layers)
        # ... Drug 2, Drug 3
        # 45: Clone A (Margin)
        # 46: Clone A (Core)
        # 47: Clone B (Margin)
        # 48: Clone B (Core)
        # 49: Clone C (Margin)
        # 50: Clone C (Core)
        # 51: T-Cells (Margin)
        # 52: T-Cells (Core)
        
    def derivatives(self, t, y, dose_rate):
        dydt = np.zeros_like(y)
        
        # --- PBPK & Spatial Diffusion ---
        # Simplified for speed: Central -> Stroma -> Margin -> Core
        # Drug 1
        C_cent = y[0]
        C_stroma = y[1]
        C_margin = y[2]
        C_core = y[3]
        
        # Diffusion Constants (affected by Stroma)
        k_diff = 0.5 * (1 - self.p['stroma']) # High stroma = Low diffusion
        
        dydt[0] = dose_rate[0] - 1.0*C_cent - k_diff*(C_cent - C_stroma) # Central
        dydt[1] = k_diff*(C_cent - C_stroma) - k_diff*(C_stroma - C_margin) # Stroma
        dydt[2] = k_diff*(C_stroma - C_margin) - k_diff*(C_margin - C_core) # Margin
        dydt[3] = k_diff*(C_margin - C_core) - 0.1*C_core # Core (sink)
        
        # Repeat for Drugs 2, 3 (Indices 15.., 30..)
        # ... (Simplified: assume similar kinetics for demo)
        
        # --- Clonal Dynamics ---
        # Growth Rates
        r_A = 0.02 # Fast
        r_B = 0.015 # Cost of resistance
        r_C = 0.025 # Super-clone
        
        # Kill Rates (Drug 1+2)
        # Margin has high drug, Core has low drug
        kill_A_margin = 1.0 * C_margin
        kill_A_core = 1.0 * C_core # Lower conc
        
        kill_B = 0.01 * C_margin # Resistant
        
        # Clone A
        dydt[45] = r_A*y[45] - kill_A_margin*y[45] # Margin
        dydt[46] = 0.5*r_A*y[46] - kill_A_core*y[46] # Core (hypoxic growth slower)
        
        # Clone B
        dydt[47] = r_B*y[47] - kill_B*y[47]
        dydt[48] = 0.5*r_B*y[48] - kill_B*y[48]
        
        # Mutation (A -> C) under stress
        mut_rate = 1e-5 * kill_A_margin * y[45]
        dydt[49] = r_C*y[49] + mut_rate # Clone C emerges
        
        return dydt

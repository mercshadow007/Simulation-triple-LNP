# 1. Physiology & Spatial Parameters
# ==========================================
class PhysiologyGenerator:
    def __init__(self):
        # 14-Comp PBPK Volumes (L/kg)
        self.tissue_vols = {
            'Adipose': 0.214, 'Bone': 0.1, 'Brain': 0.02, 'Gut': 0.024,
            'Heart': 0.005, 'Kidney': 0.004, 'Liver': 0.026, 'Lung': 0.014,
            'Muscle': 0.4, 'Pancreas': 0.001, 'Skin': 0.037, 'Spleen': 0.002,
            'Thymus': 0.0004, 'Blood': 0.07
        }
        # Blood flows (% CO)
        self.tissue_flows = {
            'Adipose': 0.05, 'Bone': 0.05, 'Brain': 0.12, 'Gut': 0.15,
            'Heart': 0.04, 'Kidney': 0.19, 'Liver': 0.06, 'Lung': 1.0, 
            'Muscle': 0.17, 'Pancreas': 0.01, 'Skin': 0.05, 'Spleen': 0.03,
            'Thymus': 0.001
        }
    def generate_patient(self, pid, cancer_type):
        sex = np.random.choice(['M', 'F'])
        weight = np.random.normal(75, 15)
        bsa = 0.007184 * (weight**0.425) * (170**0.725)
        co = (13.0 * (bsa**0.75)) * 60 / 1000 # L/hr
        
        vols = {k: v * weight for k, v in self.tissue_vols.items()}
        flows = {k: v * co for k, v in self.tissue_flows.items()}
        
        # Tumor Props (Spatial)
        # Stroma Density (0-1): Determines diffusion barrier
        stroma_density = np.random.beta(2, 2) 
        if cancer_type == 'Pancreatic': stroma_density = np.random.beta(5, 1) # Very dense
        
        return {
            'id': pid, 'weight': weight, 'vols': vols, 'flows': flows,
            'cancer_type': cancer_type, 'stroma': stroma_density,
            'clones': self.init_clones()
        }
    
    def init_clones(self):
        # Clone A: Sensitive (95-99%)
        # Clone B: Pre-existing Resistant (1-5%)
        # Clone C: Empty (Evolves later)
        frac_b = np.random.uniform(0.01, 0.05)
        return {'A': 1.0 - frac_b, 'B': frac_b, 'C': 0.0}

# 4. Visualization
# ==========================================
def plot_hyper_results(df):
    # 1. KM Curve
    plt.figure(figsize=(10, 7))
    kmf = KaplanMeierFitter()
    
    colors = {'Chemo': 'gray', 'Dual': 'blue', 'Triple': 'red'}
    
    for arm in ['Chemo', 'Dual', 'Triple']:
        dat = df[df['arm'] == arm]
        kmf.fit(dat['pfs'], 1 - dat['censored'], label=f"{arm} (mPFS: {dat['pfs'].median():.1f}d)")
        kmf.plot(color=colors[arm], ci_show=True)
        
    plt.title("Hyper-Realistic PFS (Calibrated to Real Benchmarks)")
    plt.ylabel("Survival Probability")
    plt.xlabel("Days")
    plt.savefig('figures/fig_hyper_km.png')
    
    # 2. Stroma vs Response (Spatial Validation)
    plt.figure(figsize=(8, 6))
    sns.scatterplot(data=df[df['arm']!='Chemo'], x='stroma', y='best_resp', hue='arm', alpha=0.5)
    plt.title("Impact of Spatial Barrier (Stroma) on Efficacy")
    plt.xlabel("Stroma Density (Diffusion Barrier)")
    plt.ylabel("Best Tumor Response (%)")
    plt.savefig('figures/fig_spatial_validation.png')

